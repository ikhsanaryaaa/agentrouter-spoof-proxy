# AgentRouter Spoof Proxy — production .env for Dokploy / 9Router integration
#
# TWO-SECRET MODEL (this is the part that fixes the 401):
#   PROXY_AUTH_TOKEN  = inbound gate. 9Router's provider "API Key" field gets
#                       THIS value. Anyone hitting the proxy must send it.
#   UPSTREAM_API_KEY  = outbound credential. The real agentrouter.org API key.
#                       The proxy injects it upstream, so 9Router never holds
#                       the AgentRouter key.
#
# Set only PROXY_AUTH_TOKEN and leave UPSTREAM_API_KEY empty -> the client's
# Authorization header is forwarded as-is to agentrouter.org. That is the
# legacy single-token mode: 9Router's Key field must then contain the real
# AgentRouter key (sk-...). Both work, pick one and be consistent.

# --- Inbound gate (9Router provider API key = this value) -------------------
# Generate with: openssl rand -hex 32
PROXY_AUTH_TOKEN=CHANGE_ME_GATE_TOKEN

# --- Outbound credential (real agentrouter.org API key) ---------------------
# Leave empty to run in legacy single-token mode (see header above).
UPSTREAM_API_KEY=

# --- Optional: model auto-discovery (agentrouter.org key) -------------------
# Same value as UPSTREAM_API_KEY enables dynamic model list from your account.
# When empty the static MODELS_CSV list is served.
AR_API_KEY=

# --- Network ---------------------------------------------------------------
LISTEN_PORT=8318
LISTEN_ADDRESS=0.0.0.0

# --- Upstream --------------------------------------------------------------
TARGET_PROTOCOL=https
TARGET_HOST=agentrouter.org
TARGET_PORT=443

# --- Model list (static fallback when AR_API_KEY is empty) ------------------
MODELS_CSV=claude-opus-4-8,claude-opus-5,deepseek-v4-flash,glm-5.3,gpt-5.6-sol,gpt-6-astra

# --- Timing ----------------------------------------------------------------
# Upstream headers timeout. Raise if agentrouter.org is slow to first byte.
RESPONSE_TIMEOUT_MS=60000
# Max silence inside an SSE stream before it is declared dead (10 min).
SSE_IDLE_TIMEOUT_MS=600000
# Quiet-stream threshold: marked SLOW but the stream is NOT cut.
SSE_CHUNK_TIMEOUT_MS=30000
BODY_UPLOAD_TIMEOUT_MS=60000
SLOW_RESPONSE_MS=30000
WARMUP_INTERVAL_MS=180000
DISCOVERY_INTERVAL_MS=600000

# --- Retry / circuit breaker ----------------------------------------------
MAX_RETRIES=2
RETRY_DELAY_MS=1000
# Retries resend the full body and can double-bill tokens. Keep false.
RETRY_ON_5XX=false

# --- Fingerprint / persona -------------------------------------------------
# Which CLI the upstream WAF believes you are.
# opencode | claude-code | codex | qwen | cline | roo | kilo | cursor | trae
# | pi | openclaw | hermes | droid | copilot | gemini | generic
SPOOF_PROFILE=opencode
EXPOSURE_MODE=auto
STRIP_THINKING_TAGS=true

# --- Logging ---------------------------------------------------------------
# debug shows request summaries, upstream response bodies and WAF warmup.
LOG_LEVEL=info
